meta {
  name: 01 Register Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@test.com",
    "password": "Password123!",
    "full_name": "Platform Admin",
    "role": "admin"
  }
}

docs {
  NOTE: In production, admin registration should be disabled or restricted.
  For now we allow it for testing. The role 'admin' is not in the allowed
  registration roles - you may need to insert directly into DB:
  
  UPDATE users SET role = 'admin' WHERE email = 'admin@test.com';
}