meta {
  name: 01 Initiate Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/deals/{{dealId}}/pay
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "gateway": "manual",
    "gateway_txn_id": "TXN-MANUAL-001"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.payment) {
    bru.setEnvVar("paymentId", res.body.data.payment.id.toString());
  }
}

docs {
  Must be logged in as the brand that owns the campaign.
  Deal must be in 'approved' or 'completed' status.
  Using 'manual' gateway auto-completes the payment and creates payout entries.
}