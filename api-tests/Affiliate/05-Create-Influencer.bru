meta {
  name: 05 Onboard New Influencer
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/affiliates/me/influencers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email": "onboarded-influencer@test.com",
    "full_name": "Sneha Kapoor",
    "password": "Password123!",
    "base_cost_per_post": 3000,
    "base_cost_per_video": 8000
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.influencer) {
    bru.setEnvVar("affiliateInfluencerId", res.body.data.influencer.id.toString());
  }
}